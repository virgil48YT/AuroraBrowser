<?xml version="1.0" encoding="utf-8"?>
<!--
  Outline of the toolbar's tab button. The explicit transparent fill matters:
  a GradientDrawable without a solid colour is filled with opaque black as
  soon as a tint/colour filter is applied, which turned the tab button into
  a solid grey square that hid its contents.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="2dp" android:color="@color/chrome_text" />
    <corners android:radius="5dp" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launcher_background">

    <ImageView
        android:id="@+id/homeBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/aurora_bg" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home_scrim" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/homeClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/home_text"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/homeDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/home_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/homeLogo"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginTop="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/aurora_mark" />

            <TextView
                android:id="@+id/homeWordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/wordmark"
                android:textAppearance="@style/TextAppearance.Aurora.Wordmark" />

            <com.aurora.browser.ui.GlowFrameLayout
                android:id="@+id/homeSearchPill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:clickable="true"
                android:focusable="true"
                app:glowAlpha="120"
                app:glowCornerRadius="28dp"
                app:glowFill="@color/home_pill"
                app:glowSpread="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_search"
                        app:tint="@color/home_cyan" />

                    <TextView
                        android:id="@+id/homeSearchHint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/omnibox_hint"
                        android:textColor="@color/home_text_muted"
                        android:textSize="16sp" />
                </LinearLayout>
            </com.aurora.browser.ui.GlowFrameLayout>

            <TextView
                android:id="@+id/homeBlocked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:textColor="@color/home_text_muted"
                android:textSize="12sp" />

            <!-- Incognito explanation (incognito tabs only) -->
            <com.aurora.browser.ui.GlowFrameLayout
                android:id="@+id/homeIncognitoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_incognito"
                        app:tint="@color/home_purple" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/incognito_title"
                        android:textColor="@color/home_text"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/incognito_body"
                        android:textColor="@color/home_text_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/homeIncognitoIsolation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/home_cyan"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.aurora.browser.ui.GlowFrameLayout>

            <com.aurora.browser.ui.GlowFrameLayout
                android:id="@+id/homeShortcutsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/shortcuts"
                        android:textAppearance="@style/TextAppearance.Aurora.CardTitle" />

                    <GridLayout
                        android:id="@+id/homeShortcuts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:columnCount="4" />

                    <TextView
                        android:id="@+id/homeShortcutsEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/no_shortcuts"
                        android:textColor="@color/home_text_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.aurora.browser.ui.GlowFrameLayout>

            <com.aurora.browser.ui.GlowFrameLayout
                android:id="@+id/homeRecentCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/recently_visited"
                        android:textAppearance="@style/TextAppearance.Aurora.CardTitle" />

                    <LinearLayout
                        android:id="@+id/homeRecent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/homeRecentEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/no_history"
                        android:textColor="@color/home_text_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.aurora.browser.ui.GlowFrameLayout>

            <com.aurora.browser.ui.GlowFrameLayout
                android:id="@+id/homeActionsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quick_actions"
                        android:textAppearance="@style/TextAppearance.Aurora.CardTitle" />

                    <LinearLayout
                        android:id="@+id/homeActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal" />
                </LinearLayout>
            </com.aurora.browser.ui.GlowFrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>

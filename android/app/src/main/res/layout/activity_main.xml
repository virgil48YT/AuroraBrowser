<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aurora_surface">

    <LinearLayout
        android:id="@+id/browserColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:background="@color/chrome_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <com.aurora.browser.ui.FaIconView
                android:id="@+id/btnHome"
                android:layout_width="@dimen/toolbar_button"
                android:layout_height="@dimen/toolbar_button"
                android:background="@drawable/bg_toolbar_button"
                android:contentDescription="@string/home"
                app:faGlyph="0xF015"
                android:gravity="center"
                android:textColor="@color/chrome_text"
                android:textSize="19sp" />

            <LinearLayout
                android:id="@+id/omniboxFrame"
                android:layout_width="0dp"
                android:layout_height="@dimen/omnibox_height"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_omnibox"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="4dp">

                <!-- Built-in Tor indicator: shown while Tor mode is on (purple
                     when connected, dimmed while connecting); tap for status. -->
                <ImageView
                    android:id="@+id/torBadge"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="-6dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_toolbar_button"
                    android:contentDescription="@string/tor_status_desc"
                    android:padding="5dp"
                    android:src="@drawable/ic_tor_onion"
                    android:visibility="gone" />

                <com.aurora.browser.ui.FaIconView
                    android:id="@+id/siteIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:textColor="@color/chrome_muted"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/omnibox"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/omnibox_hint"
                    android:imeOptions="actionGo|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textColor="@color/chrome_text"
                    android:textColorHint="@color/chrome_muted"
                    android:textSize="15sp" />

                <com.aurora.browser.ui.FaIconView
                    android:id="@+id/btnClearOmnibox"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/clear"
                    app:faGlyph="0xF00D"
                    android:gravity="center"
                    android:textColor="@color/chrome_muted"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnShield"
                android:layout_width="@dimen/toolbar_button"
                android:layout_height="@dimen/toolbar_button"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_toolbar_button"
                android:clickable="true"
                android:contentDescription="@string/shields"
                android:focusable="true">

                <!-- Fills the button and centres the glyph both ways, like the
                     other toolbar icons (a 24dp box without gravity left the
                     glyph pinned to its top-left corner). -->
                <com.aurora.browser.ui.FaIconView
                    android:id="@+id/shieldIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/shieldBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_badge"
                    android:gravity="center"
                    android:minWidth="16dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textColor="@color/aurora_on_accent"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnTabs"
                android:layout_width="@dimen/toolbar_button"
                android:layout_height="@dimen/toolbar_button"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_toolbar_button"
                android:clickable="true"
                android:contentDescription="@string/tab_switcher"
                android:focusable="true">

                <!-- Outlined tile with a plus glyph: tap opens the tab switcher,
                     long-press opens a new tab. The open-tab count sits in a
                     small badge on the corner. -->
                <com.aurora.browser.ui.FaIconView
                    android:id="@+id/tabIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_tab_count"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textColor="@color/chrome_text"
                    android:textSize="11sp"
                    app:faGlyph="0xF067" />

                <TextView
                    android:id="@+id/tabCount"
                    android:layout_width="wrap_content"
                    android:layout_height="15dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_tab_badge"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:minWidth="15dp"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:textColor="@color/chrome_bg"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    tools:text="1" />
            </FrameLayout>

            <com.aurora.browser.ui.FaIconView
                android:id="@+id/btnMenu"
                android:layout_width="@dimen/toolbar_button"
                android:layout_height="@dimen/toolbar_button"
                android:background="@drawable/bg_toolbar_button"
                android:contentDescription="@string/menu"
                app:faGlyph="0xF142"
                android:gravity="center"
                android:textColor="@color/chrome_text"
                android:textSize="19sp" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="false"
            android:visibility="invisible"
            app:indicatorColor="@color/aurora_accent"
            app:trackColor="@android:color/transparent"
            app:trackThickness="2dp" />

        <FrameLayout
            android:id="@+id/contentFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/aurora_background">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:id="@+id/webHolder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <include
                android:id="@+id/homeView"
                layout="@layout/view_home"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/suggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_panel"
                android:elevation="8dp"
                android:paddingBottom="8dp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/findBar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/chrome_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/findInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/find_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/chrome_text"
                android:textColorHint="@color/chrome_muted" />

            <TextView
                android:id="@+id/findCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:textColor="@color/chrome_muted"
                android:textSize="13sp" />

            <com.aurora.browser.ui.FaIconView
                android:id="@+id/findPrev"
                android:layout_width="@dimen/toolbar_button"
                android:layout_height="@dimen/toolbar_button"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/previous"
                app:faGlyph="0xF077"
                android:gravity="center"
                android:textColor="@color/chrome_text"
                android:textSize="15sp" />

            <com.aurora.browser.ui.FaIconView
                android:id="@+id/findNext"
                android:layout_width="@dimen/toolbar_button"
                android:layout_height="@dimen/toolbar_button"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/next"
                app:faGlyph="0xF078"
                android:gravity="center"
                android:textColor="@color/chrome_text"
                android:textSize="15sp" />

            <com.aurora.browser.ui.FaIconView
                android:id="@+id/findClose"
                android:layout_width="@dimen/toolbar_button"
                android:layout_height="@dimen/toolbar_button"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                app:faGlyph="0xF00D"
                android:gravity="center"
                android:textColor="@color/chrome_text"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <include
        android:id="@+id/tabSwitcher"
        layout="@layout/view_tab_switcher"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/fullscreenHolder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />
</FrameLayout>
